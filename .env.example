# 复制成 .env 再填值；.env 已被 .gitignore 排除，不会进仓库。
#
# 注意：三个变量名不一样，对应不同的使用者。同一个 Access Secret 填三遍即可。

# @klarkxy/dsh-zhihu（DSH 插件的知乎工具与搜索提供方）
ZHIHU_ACCESS_TOKEN=

# dsh-zhihu-search / zhihu-mcp-proxy
ZHIHU_ACCESS_SECRET=

# dsh-free-search 的知乎搜索引擎（zhihu_global / zhihu_site）
ZHIHU_API_KEY=

# ---- 以下都可选；不填也有 8 个免 key 搜索引擎可用 ----
# BOCHA_API_KEY=
# TAVILY_API_KEY=
# EXA_API_KEY=
# FIRECRAWL_API_KEY=

# 覆盖 B站请求的 User-Agent（默认内置一个常见 Chrome UA）
# BILI_UA=
