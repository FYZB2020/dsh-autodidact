# 复制成 .env 再填值；.env 已被 .gitignore 排除，不会进仓库。
#
# 注意：三个变量名不一样，对应不同的使用者。同一个 Access Secret 填三遍即可。

# @klarkxy/dsh-zhihu（DSH 插件的知乎工具与搜索提供方）
ZHIHU_ACCESS_TOKEN=

# dsh-zhihu-search / zhihu-mcp-proxy
ZHIHU_ACCESS_SECRET=

# dsh-free-search 的知乎搜索引擎（zhihu_global / zhihu_site）
ZHIHU_API_KEY=

# ---- 以下都可选；不填也有 8 个免 key 搜索引擎可用 ----

# ★ 建议优先配这两个。它们都是「给 AI agent 用的搜索 API」：返回的是
#   **能直接喂模型的干净文本**，不是原始 HTML —— 省的不只是搜索本身，更是上下文 token。
#
#   Exa    https://dashboard.exa.ai/onboarding-guest
#          免费：每月 $10 credits + 一次性 $10 开户奖励，**不要付款方式**
#          单价：Search $4/1k 请求（≤10 条结果）
#   Tavily https://app.tavily.com/home
#          免费：每月 1000 API credits（每月 1 日重置），**不要信用卡**
#          单价：PAYGO $0.008/credit；另有学生免费档
#
# 不填也能用（Exa 有 keyless 回退；Tavily 是官方 keyless 档
# X-Tavily-Access-Mode: keyless），填了只是额度内更稳、更快。
# EXA_API_KEY=
# TAVILY_API_KEY=

# ---- 其他可选 ----
# BOCHA_API_KEY=
# FIRECRAWL_API_KEY=

# 覆盖 B站请求的 User-Agent（默认内置一个常见 Chrome UA）
# BILI_UA=
